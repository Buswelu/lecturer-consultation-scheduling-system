# ---------------------------------------------------------------------------
# LCSS — Supabase configuration (Phase 2: Database Foundation)
#
# 1. Copy this file to `.env.local` (never commit `.env.local` — it is
#    git-ignored) and fill in the values from your Supabase project:
#    Supabase Dashboard → Project Settings → API.
# 2. Until these values are set, the app keeps running on the built-in
#    mock data layer (`IS_MOCK = true` in `src/lib/services/*`).
# ---------------------------------------------------------------------------

# Public Supabase project URL (safe to expose in the browser).
NEXT_PUBLIC_SUPABASE_URL=

# Public Supabase anonymous key (safe to expose in the browser).
# Row Level Security (RLS) enforces authorization — the anon key alone
# grants nothing beyond what RLS policies allow.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only (NEVER expose via NEXT_PUBLIC_*, NEVER commit) ------------
# Service-role key bypasses RLS. Only used in server-side code
# (`src/lib/supabase/server.ts` → `createServiceClient()`), e.g. for
# admin provisioning or system-generated notifications.
# SUPABASE_SERVICE_ROLE_KEY=

