# ---------------------------------------------------------------------------
# LCSS — environment configuration (self-managed PostgreSQL)
#
# Copy this file to `.env.local` (never commit `.env.local` — it is
# git-ignored) and fill in the server-only values below.
# ---------------------------------------------------------------------------

# --- Self-managed PostgreSQL (server-only, NEVER NEXT_PUBLIC_*) ------------
# Local development database connection. The password below is a placeholder —
# never commit real credentials. Copy to .env.local and fill in yours:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/Consultation_db
DATABASE_URL=

# Expected database name guard for db:* scripts (defaults to Consultation_db).
# LCSS_TARGET_DB=Consultation_db

# --- Self-managed PG auth (server-only, NEVER NEXT_PUBLIC_*, NEVER commit) ---
# Binds session/reset/verification token hashes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Session lifetime in seconds (default 604800 = 7 days).
# SESSION_TTL_SECONDS=604800

# Server-side base URL for auth links.
# APP_URL=http://localhost:3000

# Local-only: return single-use auth tokens in API JSON for manual testing.
# Never enable in production.
# LCSS_DEV_TOKENS=1

# --- Auth rate limiting (all optional — defaults apply when unset) ---------
# Application rate limit: protects the PostgreSQL login/recovery/register
# endpoints (`src/app/api/pg-auth/*`), enforced server-side with atomic
# PostgreSQL counters BEFORE password verification.
#
# Login: max failed attempts within window, then temporary lockout.
# AUTH_LOGIN_MAX_ATTEMPTS=5
# AUTH_LOGIN_WINDOW_SECONDS=300
# AUTH_LOGIN_LOCKOUT_SECONDS=900
#
# Password recovery: independent limiter (attempts per window).
# AUTH_RECOVERY_MAX_ATTEMPTS=3
# AUTH_RECOVERY_WINDOW_SECONDS=3600
# AUTH_RECOVERY_LOCKOUT_SECONDS=3600
#
# Registration: independent limiter (attempts per window, successes count).
# AUTH_REGISTER_MAX_ATTEMPTS=5
# AUTH_REGISTER_WINDOW_SECONDS=3600
# AUTH_REGISTER_LOCKOUT_SECONDS=3600
